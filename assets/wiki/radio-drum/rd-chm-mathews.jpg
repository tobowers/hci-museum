    <script type="text/javascript">
        jQuery(document).ready(function ($) {
            // Function to update margin-top based on popup height
            function updateMargins() {
                var popupHeight = $('#popmake-32050').outerHeight();
                if (popupHeight > 0) { // Ensure popupHeight is valid
                    $('body').css('margin-top', popupHeight + 'px');
                    $('header').css('margin-top', popupHeight + 'px');
                }
            }

            // Adjust margin-top when popup opens
            $(document).on('pumAfterOpen', '#pum-32050', function () { 
                updateMargins();

                // Add a resize listener for the duration the popup is open
                $(window).on('resize.popup', function () {
                    updateMargins();
                });
            });

            // Reset margin-top when popup closes
            $(document).on('pumAfterClose', '#pum-32050', function () { 
                $('body').css('margin-top', '0');
                $('header').css('margin-top', '0');

                // Remove the resize listener when the popup closes
                $(window).off('resize.popup');
            });
        });
    </script>



