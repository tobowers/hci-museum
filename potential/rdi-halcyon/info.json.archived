    "Halcyon laserdisc game system RDI",
    "Rick Dyer Halcyon interactive movie",
    "RDI Video Systems Halcyon",
    "Halcyon console rare CES 1985",
    "voice recognition game console 1985"
  ],
  "research": {
    "title": "RDI Halcyon",
